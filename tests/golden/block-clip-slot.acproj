  "group_defs": {
    "clip-slot": {
      "name": "Clip Slot",
      "description": "One slot of a clip launcher: press `launch` and its clip starts on the next bar line (every slot waits for the bar: the Grid clock inside, which you can change for all of them); press `stop` (or launch another slot on the track, wired into `release`) and it stops on the next bar. The Add menu's Clip Slot template adds one wired to the selected Clip, with a card on the panel that is the slot's button and light.\n\n- `launch` (trigger): the slot's own button, on its card.\n- `scene` (trigger): a scene button launching a row of slots.\n- `release` (trigger): another slot on the same track launched: wire that slot's `launched` here, and this one's `launched` into its `release`, for one slot playing at a time.\n- `stop` (trigger): the track's stop button.\n- `start` and `end` (triggers): wire them into the clip's `start` and `stop`.\n- `launched` (trigger): fires on every launch. `armed` is on from a launch until a release or stop; `playing` follows it on the grid.\n\nInside: two Merges gather the launches and the releases into a Latch; a Clock on the grid samples it with a Sample & Hold, and two Gate to Triggers turn the changes into `start` and `end`.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "launcher",
        "clips",
        "session",
        "performance"
      ],
      "source": "shipped:clip-slot",
      "inputs": [
        {
          "name": "launch",
          "type": "trigger",
          "targets": [
            "1:in_0"
          ]
        },
        {
          "name": "scene",
          "type": "trigger",
          "targets": [
            "1:in_1"
          ]
        },
        {
          "name": "release",
          "type": "trigger",
          "targets": [
            "2:in_0"
          ]
        },
        {
          "name": "stop",
          "type": "trigger",
          "targets": [
            "2:in_1"
          ]
        }
      ],
      "outputs": [
        {
          "name": "start",
          "type": "trigger",
          "source": "7:out"
        },
        {
          "name": "end",
          "type": "trigger",
          "source": "8:out"
        },
        {
          "name": "launched",
          "type": "trigger",
          "source": "1:out"
        },
        {
          "name": "playing",
          "type": "bool",
          "source": "6:out"
        },
        {
          "name": "armed",
          "type": "bool",
          "source": "3:out"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "merge",
            "config": {
              "type": "trigger",
              "inputs": 2
            },
            "ui": {
              "pos": [
                0.0,
                0.0
              ],
              "label": "Launches"
            }
          },
          {
            "id": "2",
            "kind": "merge",
            "config": {
              "type": "trigger",
              "inputs": 2
            },
            "ui": {
              "pos": [
                0.0,
                200.0
              ],
              "label": "Releases"
            }
          },
          {
            "id": "3",
            "kind": "latch",
            "ui": {
              "pos": [
                280.0,
                0.0
              ],
              "label": "Armed"
            }
          },
          {
            "id": "4",
            "kind": "clock",
            "params": {
              "interval": 4.0
            },
            "ui": {
              "pos": [
                280.0,
                220.0
              ],
              "label": "Grid"
            }
          },
          {
            "id": "5",
            "kind": "sample_hold",
            "ui": {
              "pos": [
                560.0,
                0.0
              ],
              "label": "On the grid"
            }
          },
          {
            "id": "6",
            "kind": "compare",
            "params": {
              "b": 0.5,
              "op": "greater"
            },
            "ui": {
              "pos": [
                840.0,
                0.0
              ],
              "label": "Playing"
            }
          },
          {
            "id": "7",
            "kind": "gate_to_trigger",
            "ui": {
              "pos": [
                1120.0,
                0.0
              ],
              "label": "Start"
            }
          },
          {
            "id": "8",
            "kind": "gate_to_trigger",
            "params": {
              "edge": "falling"
            },
            "ui": {
              "pos": [
                1120.0,
                160.0
              ],
              "label": "End"
            }
          }
        ],
        "wires": [
          {
            "from": "1:out",
            "to": "3:set"
          },
          {
            "from": "2:out",
            "to": "3:reset"
          },
          {
            "from": "3:out",
            "to": "5:in"
          },
          {
            "from": "4:trigger",
            "to": "5:trigger"
          },
          {
            "from": "5:out",
            "to": "6:a"
          },
          {
            "from": "6:out",
            "to": "7:in"
          },
          {
            "from": "6:out",
            "to": "8:in"
          }
        ]
      }
    }
  },
  "golden": {
    "block_independent": true
  }
}
