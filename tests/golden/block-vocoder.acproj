  "group_defs": {
    "vocoder": {
      "name": "Vocoder",
      "description": "A 12-band vocoder: the `carrier` takes on the changing spectrum of the `modulator`, so a synth can be made to speak. Typically the modulator is a voice (from an Audio In) and the carrier a bright synth chord or noise; what comes out has the synth's pitch and the voice's words.\n\n- `carrier` (audio) is the sound you hear, reshaped. It needs energy all across the spectrum: a sawtooth chord, noise, or both mixed.\n- `modulator` (audio) is the sound whose spectral shape is imposed: its level in each band sets the carrier's level in that band.\n- `attack` and `release` (seconds) are how quickly each band follows the modulator getting louder and quieter: short for crisp, intelligible words, longer for a smoother, smeared sound.\n- `level` (dB) is the output gain. At 0 a carrier band passes unchanged while the matching modulator band peaks at full scale, and drops as that band gets quieter, so quiet modulators need more.\n- `out` is the vocoded carrier, mono or stereo like the carrier.\n\nInside: two Band Splits with the same edges cut the modulator and the carrier into 12 matching bands, half an octave apart from 200 Hz to 6.4 kHz, plus everything below and above. On each modulator band an Envelope Follower measures the level in decibels, and that drives the Gain on the matching carrier band directly, since a Gain takes decibels (and is silent at −60 dB, so bands where the modulator is silent stay closed). A Mix adds the 12 bands back together, with `level` as the gain of every input. The crossover bands overlap the way a classic filter-bank vocoder's do, which softens the contrast between neighbouring bands; for sharper bands, set both Band Splits' `mode` to fft, at the cost of the latency it adds. To change the bands, edit the edges of both Band Splits the same way.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "vocoder",
        "effect",
        "spectral",
        "voice",
        "filter"
      ],
      "source": "shipped:vocoder",
      "inputs": [
        {
          "name": "carrier",
          "type": "audio",
          "targets": [
            "2:in"
          ]
        },
        {
          "name": "modulator",
          "type": "audio",
          "targets": [
            "1:in"
          ]
        },
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
          "default": 0.005,
          "range": [
            0.0,
            0.5
          ],
          "targets": [
            "4:attack",
            "6:attack",
            "8:attack",
            "a:attack",
            "c:attack",
            "e:attack",
            "10:attack",
            "12:attack",
            "14:attack",
            "16:attack",
            "18:attack",
            "1a:attack"
          ]
        },
        {
          "name": "release",
          "type": "float",
          "unit": "seconds",
          "default": 0.05,
          "range": [
            0.0,
            2.0
          ],
          "targets": [
            "4:release",
            "6:release",
            "8:release",
            "a:release",
            "c:release",
            "e:release",
            "10:release",
            "12:release",
            "14:release",
            "16:release",
            "18:release",
            "1a:release"
          ]
        },
        {
          "name": "level",
          "type": "float",
          "unit": "db",
          "default": 6.0,
          "range": [
            -24.0,
            36.0
          ],
          "targets": [
            "3:gain_0",
            "3:gain_1",
            "3:gain_2",
            "3:gain_3",
            "3:gain_4",
            "3:gain_5",
            "3:gain_6",
            "3:gain_7",
            "3:gain_8",
            "3:gain_9",
            "3:gain_10",
            "3:gain_11"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "3:out"
        }
      ],
