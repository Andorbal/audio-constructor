  "group_defs": {
    "metronome": {
      "name": "Metronome",
      "description": "Clicks on every beat while the transport plays, with a higher click on the first beat of each bar. Follows the project tempo.\n\n- `volume` (dB): how loud the clicks are.\n- `enabled`: switch the clicks on or off (with a 5 ms fade).\n- `beats_per_bar`: beats in a bar, counted from the start of the song; set it to match the time signature (3 for a waltz).\n- `out` (audio, mono): the clicks. Send it to its own output to make a click track only you hear.\n\nInside: one Clock ticks on every beat and another on every bar. The bar ticks start the accent click; a Switch in trigger mode passes the beat ticks only while the bar clock's short gate is low, so the downbeat doesn't get both clicks. Each click is a sine Oscillator, restarted from the top of its cycle by the tick so every click sounds the same, multiplied by an ADSR that jumps up and dies away in about 40 ms. The accent sounds an octave higher (1760 Hz against 880 Hz) and 3 dB louder. A Mix adds the two, a Gain sets the volume, and a Switch in audio mode turns the result on and off.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "rhythm",
        "utility",
        "click",
        "tempo"
      ],
      "source": "shipped:metronome",
      "inputs": [
        {
          "name": "volume",
          "type": "float",
          "unit": "db",
          "default": -6.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "11:gain"
          ]
        },
        {
          "name": "enabled",
          "type": "bool",
          "default": true,
          "targets": [
            "12:select"
          ]
        },
        {
          "name": "beats_per_bar",
          "type": "float",
          "unit": "beats",
          "default": 4.0,
          "range": [
            1.0,
            16.0
          ],
          "targets": [
            "2:interval"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "12:out"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "clock",
            "params": {
              "duty": 0.5,
              "interval": 1.0
            },
            "ui": {
              "pos": [
                0.0,
                320.0
              ],
              "label": "Beat"
            }
          },
          {
            "id": "2",
            "kind": "clock",
            "params": {
              "duty": 0.02
            },
            "ui": {
              "pos": [
                0.0,
                0.0
              ],
              "label": "Bar"
            }
          },
          {
            "id": "3",
            "kind": "switch",
            "config": {
              "type": "trigger"
            },
            "ui": {
              "pos": [
                220.0,
                320.0
              ],
              "label": "Not the downbeat"
            }
          },
          {
            "id": "4",
            "kind": "adsr",
            "params": {
              "attack": 0.0,
              "curve": "exponential",
              "decay": 0.04,
              "release": 0.01,
              "sustain": 0.0
            },
            "ui": {
              "pos": [
                440.0,
                0.0
              ],
              "label": "Accent envelope"
            }
          },
          {
            "id": "5",
            "kind": "oscillator",
            "params": {
              "freq": 1760.0,
              "shape": "sine",
              "start": "play"
            },
            "ui": {
              "pos": [
                440.0,
                160.0
              ],
              "label": "Accent tone"
            }
          },
          {
            "id": "6",
            "kind": "math",
            "params": {
              "op": "multiply"
            },
            "ui": {
              "pos": [
                660.0,
                0.0
              ]
            }
          },
          {
            "id": "7",
            "kind": "adsr",
            "params": {
              "attack": 0.0,
              "curve": "exponential",
              "decay": 0.04,
              "release": 0.01,
              "sustain": 0.0
            },
            "ui": {
              "pos": [
                440.0,
                320.0
              ],
              "label": "Beat envelope"
            }
          },
          {
            "id": "8",
            "kind": "oscillator",
            "params": {
              "freq": 880.0,
              "shape": "sine",
              "start": "play"
            },
            "ui": {
              "pos": [
                440.0,
                480.0
              ],
              "label": "Beat tone"
            }
          },
          {
            "id": "9",
