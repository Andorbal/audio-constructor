  "group_defs": {
    "chorus": {
      "name": "Chorus",
      "description": "Thickens a sound into an ensemble: three copies of it, each delayed by a slowly wobbling time, are spread left, right, and center and blended with the original. Mono or stereo in, stereo out.\n\n- `in`: the signal (mono or stereo; the copies are made from its mono sum, the dry part keeps its stereo image).\n- `rate` (Hz): how fast the delays wobble. 0.2 to 1 Hz is a gentle chorus; above 3 Hz it turns into a warble.\n- `depth` (0 to 1): how far they wobble. Each delay sweeps 15 ms ± `depth` × 5 ms, so 0 is a static doubling and 1 sweeps from 10 to 20 ms.\n- `mix` (0 to 1): 0 is only the dry signal, 1 only the three copies; 0.5 is the classic blend. The blend is equal-power, so the loudness holds steady across the range.\n- `out`: the stereo result.\n\nInside: Mid/Side takes the mono sum of the input. Three `pure` sine Oscillators at `rate`, a third of a cycle apart, are mapped from −1..1 onto the shortest and longest delay (worked out from `depth` with Math) and drive the `time` of three Delays with no feedback, so each copy's pitch bends gently up and down out of step with the others. Pans place the copies hard left, hard right, and center, a Mix sums them, and an equal-power Crossfade blends them with the dry input.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "modulation",
        "chorus",
        "stereo",
        "delay",
        "effect"
      ],
      "source": "shipped:chorus",
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "1:in",
            "18:a"
          ]
        },
        {
          "name": "rate",
          "type": "float",
          "unit": "hz",
          "default": 0.5,
          "range": [
            0.05,
            5.0
          ],
          "targets": [
            "2:freq",
            "3:freq",
            "4:freq"
          ]
        },
        {
          "name": "depth",
          "type": "float",
          "default": 0.4,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "5:a"
          ]
        },
        {
          "name": "mix",
          "type": "float",
          "default": 0.5,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "18:mix"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "18:out"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "mid_side",
            "ui": {
              "pos": [
                0.0,
                0.0
