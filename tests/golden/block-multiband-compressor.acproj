  "group_defs": {
    "compressor": {
      "name": "Compressor",
      "description": "Evens out levels: whenever the signal rises above `threshold`, it is turned down so that every `ratio` dB over the threshold comes out as 1 dB over. Mono or stereo (both sides are turned down together, so the image stays put).\n\n- `threshold` (dB): the level where compression starts.\n- `ratio`: how hard levels over the threshold are pressed down; 4 means 4:1, 20 and up is close to limiting.\n- `attack` and `release` (seconds): how quickly the compressor turns down when the level jumps up, and how quickly it lets go when it falls back (the time the measured level takes to cover about 63 % of a jump). Attacks of a few milliseconds or more let the start of each note through, which keeps drums punchy.\n- `knee` (dB): rounds the corner at the threshold over that width so compression sets in gradually; 0 is a hard knee.\n- `makeup` (dB): gain added after compression to win back the lost level.\n- `gain_reduction` (output, dB): how far the signal is being turned down right now (0 or negative, before `makeup`), for a meter or to drive something else.\n\nInside: an Envelope Follower measures the peak level in decibels with the attack and release times, a Gain Computer turns that level into a gain change from the threshold, ratio, and knee, a Math node adds the make-up gain, and a Gain applies the result to the input.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "dynamics",
        "compressor",
        "mixing"
      ],
      "source": "shipped:compressor",
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "1:in",
            "4:in"
          ]
        },
        {
          "name": "threshold",
          "type": "float",
          "unit": "db",
          "default": -20.0,
          "range": [
            -60.0,
            0.0
          ],
          "targets": [
            "2:threshold"
          ]
        },
        {
          "name": "ratio",
          "type": "float",
          "unit": "ratio",
          "default": 4.0,
          "range": [
            1.0,
            20.0
          ],
          "targets": [
            "2:ratio"
          ]
        },
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
          "default": 0.01,
          "range": [
            0.0,
            0.5
          ],
          "targets": [
            "1:attack"
          ]
        },
        {
          "name": "release",
          "type": "float",
          "unit": "seconds",
          "default": 0.1,
          "range": [
            0.0,
            2.0
          ],
          "targets": [
            "1:release"
          ]
        },
        {
          "name": "knee",
          "type": "float",
          "unit": "db",
          "default": 6.0,
          "range": [
            0.0,
            24.0
          ],
          "targets": [
            "2:knee"
          ]
        },
        {
          "name": "makeup",
          "type": "float",
          "unit": "db",
          "default": 0.0,
          "range": [
            0.0,
            24.0
          ],
          "targets": [
            "3:b"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "4:out"
        },
        {
          "name": "gain_reduction",
          "type": "float",
          "source": "2:gain_reduction"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "envelope_follower",
            "params": {
              "mode": "peak"
            },
            "ui": {
              "pos": [
                0.0,
                0.0
              ],
              "label": "Detector"
            }
          },
          {
            "id": "2",
            "kind": "gain_computer",
            "params": {
              "mode": "compress"
            },
            "ui": {
              "pos": [
                220.0,
                0.0
              ]
            }
          },
          {
            "id": "3",
            "kind": "math",
            "params": {
              "op": "add"
            },
            "ui": {
              "pos": [
                440.0,
                0.0
              ],
              "label": "Make-up"
            }
          },
          {
            "id": "4",
            "kind": "gain",
            "ui": {
              "pos": [
                660.0,
                0.0
              ]
            }
          }
        ],
        "wires": [
          {
            "from": "1:level_db",
            "to": "2:level"
          },
          {
            "from": "2:gain_reduction",
            "to": "3:a"
          },
          {
            "from": "3:out",
            "to": "4:gain"
          }
        ]
      }
    },
    "multiband-compressor": {
      "name": "Multiband Compressor",
      "description": "Compresses the lows, mids, and highs separately, so a booming bass note is turned down without dulling the cymbals above it, or harsh highs are tamed without thinning the body. Mono or stereo.\n\n- `threshold_low`, `threshold_mid`, `threshold_high` (dB): where compression starts in each band: below 200 Hz, 200 Hz to 2 kHz, and above 2 kHz.\n- `ratio`: how hard every band is pressed down past its threshold (4 means 4:1).\n- `attack` and `release` (seconds): how quickly the bands are turned down and let go, shared by all three.\n- `makeup` (dB): gain added to every band after compression.\n- `gain_reduction_low`, `gain_reduction_mid`, `gain_reduction_high` (outputs, dB): how far each band is being turned down right now, for meters.\n\nThe crossover frequencies, 200 Hz and 2 kHz, are fixed in the block because they are the Band Split's `edges` config. To move them, open the block and change the edges on the Band Split inside (that changes every Multiband Compressor in the project).\n\nInside: a Band Split in crossover mode (Linkwitz-Riley filters that add back up to the input) splits the signal into three bands. Each band runs through its own instance of the Compressor block, and a Mix adds the bands back together. Open any of the three to see the compressor itself.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "dynamics",
        "compressor",
        "multiband",
        "mastering",
        "mixing"
      ],
      "source": "shipped:multiband-compressor",
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "1:in"
          ]
        },
        {
          "name": "threshold_low",
          "type": "float",
          "unit": "db",
          "default": -24.0,
          "range": [
            -60.0,
            0.0
          ],
          "targets": [
            "2:threshold"
          ]
        },
        {
          "name": "threshold_mid",
          "type": "float",
          "unit": "db",
          "default": -24.0,
          "range": [
            -60.0,
            0.0
          ],
          "targets": [
            "3:threshold"
          ]
        },
        {
          "name": "threshold_high",
          "type": "float",
          "unit": "db",
          "default": -24.0,
          "range": [
            -60.0,
            0.0
          ],
          "targets": [
            "4:threshold"
          ]
        },
        {
          "name": "ratio",
          "type": "float",
          "unit": "ratio",
          "default": 3.0,
          "range": [
            1.0,
            20.0
          ],
          "targets": [
            "2:ratio",
            "3:ratio",
            "4:ratio"
          ]
        },
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
          "default": 0.01,
          "range": [
            0.0,
            0.5
          ],
          "targets": [
            "2:attack",
            "3:attack",
            "4:attack"
          ]
        },
        {
          "name": "release",
          "type": "float",
          "unit": "seconds",
          "default": 0.15,
          "range": [
            0.0,
            2.0
          ],
          "targets": [
            "2:release",
            "3:release",
            "4:release"
          ]
        },
        {
          "name": "makeup",
          "type": "float",
          "unit": "db",
          "default": 0.0,
          "range": [
            0.0,
            24.0
          ],
          "targets": [
            "2:makeup",
            "3:makeup",
            "4:makeup"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "5:out"
        },
        {
          "name": "gain_reduction_low",
          "type": "float",
          "source": "2:gain_reduction"
        },
        {
          "name": "gain_reduction_mid",
          "type": "float",
          "source": "3:gain_reduction"
        },
        {
          "name": "gain_reduction_high",
          "type": "float",
          "source": "4:gain_reduction"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "band_split",
            "config": {
              "edges": [
                200.0,
                2000.0
              ],
              "mode": "crossover"
            },
            "ui": {
              "pos": [
                0.0,
                160.0
              ]
            }
          },
          {
            "id": "2",
            "kind": "group",
            "config": {
              "def": "compressor"
            },
            "ui": {
              "pos": [
                220.0,
                0.0
              ],
              "label": "Low"
            }
          },
          {
            "id": "3",
            "kind": "group",
            "config": {
              "def": "compressor"
            },
            "ui": {
              "pos": [
                220.0,
                160.0
              ],
              "label": "Mid"
            }
          },
          {
            "id": "4",
            "kind": "group",
            "config": {
              "def": "compressor"
            },
            "ui": {
              "pos": [
                220.0,
                320.0
              ],
              "label": "High"
            }
          },
          {
            "id": "5",
            "kind": "mix",
            "config": {
              "inputs": 3
            },
            "ui": {
              "pos": [
                440.0,
                160.0
              ]
            }
          }
        ],
        "wires": [
          {
            "from": "1:band_0",
            "to": "2:in"
          },
          {
            "from": "1:band_1",
            "to": "3:in"
          },
          {
            "from": "1:band_2",
            "to": "4:in"
          },
          {
            "from": "2:out",
            "to": "5:in_0"
          },
          {
            "from": "3:out",
            "to": "5:in_1"
          },
          {
            "from": "4:out",
            "to": "5:in_2"
          }
        ]
      }
    }
  },
