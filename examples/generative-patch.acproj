            "params": {
              "fall": 0.0,
              "mode": "exponential",
              "rise": 0.0007
            },
            "ui": {
              "pos": [
                440.0,
                0.0
              ],
              "label": "Ramp"
            }
          },
          {
            "id": "4",
            "kind": "envelope_follower",
            "params": {
              "attack": 0.0,
              "mode": "peak"
            },
            "ui": {
              "pos": [
                440.0,
                160.0
              ],
              "label": "Catch"
            }
          },
          {
            "id": "5",
            "kind": "math",
            "params": {
              "op": "max"
            },
            "ui": {
              "pos": [
                660.0,
                0.0
              ],
              "label": "Louder"
            }
          },
          {
            "id": "6",
