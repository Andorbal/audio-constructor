  "group_defs": {
    "drum-machine": {
      "name": "Drum Machine",
      "description": "A four-voice drum machine playing a sixteen-step pattern: kick, snare, closed hi-hat, and open hi-hat. It plays while the transport runs, in time with the project's tempo, starting from the first step on play.\n\n- `step` is the length of one step in beats: 0.25 is sixteenth notes, 0.5 plays the pattern at half speed.\n- `kick_level`, `snare_level`, `closed_hat_level`, and `open_hat_level` set each drum's loudness in decibels (−60 is silent).\n- `out` is the mix, mono.\n- `kick`, `snare`, `closed_hat`, and `open_hat` fire a trigger on every hit of their row. Wire them into the `start` of Samplers loaded with your own drum sounds, and turn the matching level down to −60 to replace a drum.\n\nThe beat is a basic rock groove. To change it, open the block and click cells in the Pattern (rows from the top: kick, snare, closed hat, open hat). The pattern belongs to the block's definition, so every instance in a project plays the same beat. The drums are synthesized rather than sampled because a block can't carry audio files.\n\nInside: a Clock ticks every `step` beats and drives a Pattern of 16 steps and 4 rows, and each row's trigger starts one drum. The kick is a sine Oscillator restarted on every hit, its pitch dropping fast from 200 to 45 Hz (an ADSR through an exponential Map) under a longer ADSR for the volume. The snare is white Noise through a highpass Biquad plus a short 185 Hz triangle for the body, each with its own envelope, balanced by a small Mix. Both hi-hats share the Noise through a 7 kHz highpass: the closed one with a short envelope, the open one with a long envelope that the closed hat cuts off through the ADSR's `off` input, as on a real kit. A Mix sets the levels.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "drums",
        "rhythm",
        "pattern",
        "sequencer",
        "instrument"
      ],
      "source": "shipped:drum-machine",
      "inputs": [
        {
          "name": "step",
          "type": "float",
          "unit": "beats",
          "default": 0.25,
          "range": [
            0.0625,
            1.0
          ],
          "targets": [
            "1:interval"
          ]
        },
        {
          "name": "kick_level",
          "type": "float",
          "unit": "db",
          "default": -3.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "15:gain_0"
          ]
        },
        {
          "name": "snare_level",
          "type": "float",
          "unit": "db",
          "default": -6.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "15:gain_1"
          ]
        },
        {
          "name": "closed_hat_level",
          "type": "float",
          "unit": "db",
          "default": -10.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "15:gain_2"
          ]
        },
        {
          "name": "open_hat_level",
          "type": "float",
          "unit": "db",
          "default": -12.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "15:gain_3"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "15:out"
        },
        {
          "name": "kick",
          "type": "trigger",
          "source": "2:trigger_0"
        },
        {
          "name": "snare",
          "type": "trigger",
          "source": "2:trigger_1"
        },
        {
          "name": "closed_hat",
          "type": "trigger",
          "source": "2:trigger_2"
        },
        {
          "name": "open_hat",
          "type": "trigger",
          "source": "2:trigger_3"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "clock",
            "params": {
              "duty": 0.5
            },
            "ui": {
              "pos": [
                0.0,
                0.0
              ]
            }
          },
          {
            "id": "2",
            "kind": "pattern",
            "config": {
              "steps": 16,
              "rows": 4,
              "cells": [
                "x.......x.x.....",
                "....x.......x...",
                "x.x.x.x.x.x.x...",
                "..............x."
              ]
            },
            "ui": {
              "pos": [
                250.0,
                0.0
              ]
            }
          },
          {
            "id": "3",
            "kind": "adsr",
            "params": {
              "attack": 0.0,
              "curve": "exponential",
              "decay": 0.06,
              "release": 0.0,
              "sustain": 0.0
            },
            "ui": {
