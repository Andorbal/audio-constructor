      },
      {
        "id": "7",
        "kind": "comment",
        "config": {
          "text": "Plug a guitar into input 1 of your audio interface and pick it in the Devices tab (smallest buffer that doesn't crackle; 128 frames is a good start). You hear yourself through a tone filter and an echo; no need to press play.\n\nTone: lower cutoff for a darker sound. Echo: time in seconds, feedback for more repeats, mix for how loud they are."
        },
        "ui": {
          "pos": [
            0.0,
            -180.0
          ]
        }
      },
      {
        "id": "8",
        "kind": "comment",
        "config": {
          "text": "Try this: set Echo's config unit to beats to lock the repeats to the tempo, or add a second Biquad in peak mode before Level for a mid boost."
        },
        "ui": {
          "pos": [
            500.0,
            260.0
          ]
        }
      }
    ],
    "wires": [
