  "graph": {
    "nodes": [
      {
        "id": "1",
        "kind": "comment",
        "config": {
          "text": "Welcome! This is a patch: nodes joined by wires. Sound flows left to right, from the Oscillator to Audio Out.\n\n1. Press Space to play. Press it again to stop.\n2. Drag the oscillator's freq value left and right. Ctrl-drag is fine, Shift-drag is coarse; click to type a number.\n3. Change shape to sine, square, or pulse."
        },
        "ui": {
          "pos": [
            0.0,
            -184.0
          ],
          "size": [
            520.0,
            144.0
          ]
        }
      },
      {
        "id": "2",
        "kind": "oscillator",
        "params": {
          "freq": 220.0,
          "shape": "saw"
        },
        "ui": {
          "pos": [
            0.0,
            0.0
          ]
        }
      },
      {
        "id": "3",
        "kind": "gain",
        "params": {
          "gain": -18.0
        },
        "ui": {
          "pos": [
            270.0,
            0.0
          ]
        }
      },
      {
        "id": "4",
        "kind": "meter",
