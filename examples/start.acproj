        }
      },
      {
        "id": "6",
        "kind": "audio_out",
        "ui": {
          "pos": [
            1080.0,
            0.0
          ]
        }
      },
      {
        "id": "7",
        "kind": "comment",
        "config": {
          "text": "Try this:\n• Shift+A opens the add palette. Type \"biquad\" (or \"lpf\") and press Enter, then drop it onto the wire between Oscillator and Gain to splice it in.\n• Add a second Oscillator with shape sine and freq 3 Hz, then wire its out into the first oscillator's fm socket for vibrato.\n• Select nodes and press Ctrl+G to pack them into a group; double-click one (or Ctrl+Enter) to go inside."
        },
        "ui": {
          "pos": [
            0.0,
            280.0
          ],
          "size": [
            470.0,
            160.0
          ]
        }
      },
      {
        "id": "8",
        "kind": "comment",
        "config": {
          "text": "Now break it:\n• Wire Audio Out's input from two places at once (the newest wire wins).\n• Make a loop from Gain back into the Oscillator: the Problems tab explains why it's refused, and a Feedback node is the fix.\n• Ctrl+Z undoes anything."
        },
        "ui": {
          "pos": [
            540.0,
            280.0
          ],
          "size": [
            440.0,
            128.0
          ]
        }
      }
    ],
    "wires": [
      {
        "from": "2:out",
        "to": "3:in"
      },
      {
        "from": "3:out",
        "to": "4:in"
      },
      {
        "from": "4:out",
