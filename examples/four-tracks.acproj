  "group_defs": {
    "track": {
      "name": "Track",
      "description": "Level, pan, and mute for one track: Gain → Pan. Edit it once and every track follows.",
      "version": 1,
      "tags": [
        "mixing"
      ],
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "4:in"
          ]
        },
        {
          "name": "gain",
          "type": "float",
          "unit": "db",
          "default": 0.0,
          "range": [
            -60.0,
            12.0
          ],
          "targets": [
            "3:a"
          ]
        },
        {
          "name": "pan",
          "type": "float",
          "default": 0.0,
          "range": [
            -1.0,
            1.0
          ],
          "targets": [
            "5:pan"
          ]
        },
        {
          "name": "mute",
          "type": "bool",
          "default": false,
          "targets": [
            "2:in"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "5:out"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "2",
            "kind": "map",
            "params": {
              "out_max": -120.0,
              "out_min": 0.0
            },
            "ui": {
              "pos": [
                0.0,
                160.0
              ],
              "label": "Mute"
            }
          },
          {
            "id": "3",
            "kind": "math",
            "params": {
              "op": "add"
            },
            "ui": {
              "pos": [
                270.0,
                160.0
              ]
            }
          },
          {
            "id": "4",
            "kind": "gain",
            "ui": {
              "pos": [
                540.0,
                0.0
              ]
            }
          },
          {
            "id": "5",
            "kind": "pan",
            "ui": {
              "pos": [
                810.0,
                0.0
              ]
            }
          }
        ],
        "wires": [
          {
            "from": "2:out",
            "to": "3:b"
          },
          {
            "from": "3:out",
            "to": "4:gain"
          },
          {
            "from": "4:out",
            "to": "5:in"
          }
        ]
