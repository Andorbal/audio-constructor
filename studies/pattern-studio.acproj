          "name": "predelay",
          "type": "float",
          "unit": "seconds",
          "default": 0.02,
          "range": [
            0.0,
            0.25
          ],
          "targets": [
            "2:time"
          ]
        },
        {
          "name": "decay",
          "type": "float",
          "unit": "seconds",
          "default": 2.5,
          "range": [
            0.3,
            20.0
          ],
          "targets": [
            "10:b"
          ]
        },
        {
          "name": "damping",
          "type": "float",
          "default": 0.25,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "14:damping",
            "19:damping"
          ]
        },
        {
          "name": "mix",
          "type": "float",
          "default": 0.3,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "26:mix"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "26:out"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "mid_side",
            "ui": {
              "pos": [
                0.0,
                0.0
              ],
              "label": "Mono sum"
            }
          },
          {
            "id": "2",
            "kind": "delay",
            "config": {
              "max_time": 0.5
            },
            "params": {
              "feedback": 0.0,
              "mix": 1.0
            },
            "ui": {
              "pos": [
                240.0,
                0.0
              ],
              "label": "Predelay"
            }
          },
          {
            "id": "3",
            "kind": "allpass",
            "config": {
              "max_delay": 0.02
            },
            "params": {
              "delay": 0.004771,
              "gain": 0.75
            },
            "ui": {
              "pos": [
                480.0,
                0.0
              ],
              "label": "Input diffuser 1"
            }
          },
          {
            "id": "4",
            "kind": "allpass",
            "config": {
              "max_delay": 0.02
