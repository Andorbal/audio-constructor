    "sampled-keys": {
      "name": "Sampled Keys",
      "description": "Two sample zones split at middle C, an ADSR on the level. A body for Voices.",
      "version": 1,
      "tags": [
        "instrument"
      ],
      "inputs": [
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
          "default": 0.005,
          "range": [
            0.0,
            2.0
          ],
          "targets": [
            "6:attack"
          ]
        },
        {
          "name": "release",
          "type": "float",
          "unit": "seconds",
          "default": 0.3,
          "range": [
            0.0,
            5.0
          ],
          "targets": [
            "6:release"
          ]
        }
      ],
      "outputs": [
        {
