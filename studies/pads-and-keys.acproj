    "sampled-keys": {
      "name": "Sampled Keys",
      "description": "Two sampled zones for a Voices node: notes below C4 play the low sample and C4 and up the high one, with an ADSR on the level. Zones finds the note's zone and starts that zone's Sampler.\n\n- `attack`, `release`: the level envelope.\n- `out` (audio): one voice.",
      "version": 1,
      "tags": [
        "instrument"
      ],
      "inputs": [
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
