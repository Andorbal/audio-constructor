  "group_defs": {
    "compressor": {
      "name": "Compressor",
      "description": "Evens out levels: whenever the signal rises above `threshold`, it is turned down so that every `ratio` dB over the threshold comes out as 1 dB over. Mono or stereo (both sides are turned down together, so the image stays put).\n\n- `threshold` (dB): the level where compression starts.\n- `ratio`: how hard levels over the threshold are pressed down; 4 means 4:1, 20 and up is close to limiting.\n- `attack` and `release` (seconds): how quickly the compressor turns down when the level jumps up, and how quickly it lets go when it falls back (the time the measured level takes to cover about 63 % of a jump). Attacks of a few milliseconds or more let the start of each note through, which keeps drums punchy.\n- `knee` (dB): rounds the corner at the threshold over that width so compression sets in gradually; 0 is a hard knee.\n- `makeup` (dB): gain added after compression to win back the lost level.\n- `gain_reduction` (output, dB): how far the signal is being turned down right now (0 or negative, before `makeup`), for a meter or to drive something else.\n\nInside: an Envelope Follower measures the peak level in decibels with the attack and release times, a Gain Computer turns that level into a gain change from the threshold, ratio, and knee, a Math node adds the make-up gain, and a Gain applies the result to the input.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "dynamics",
        "compressor",
        "mixing"
      ],
      "source": "shipped:compressor",
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "1:in",
            "4:in"
          ]
        },
        {
          "name": "threshold",
          "type": "float",
          "unit": "db",
          "default": -20.0,
          "range": [
            -60.0,
            0.0
          ],
          "targets": [
            "2:threshold"
          ]
        },
        {
          "name": "ratio",
          "type": "float",
          "unit": "ratio",
          "default": 4.0,
          "range": [
            1.0,
            20.0
          ],
          "targets": [
            "2:ratio"
          ]
        },
        {
          "name": "attack",
          "type": "float",
          "unit": "seconds",
          "default": 0.01,
          "range": [
            0.0,
            0.5
          ],
          "targets": [
            "1:attack"
          ]
        },
        {
          "name": "release",
          "type": "float",
          "unit": "seconds",
          "default": 0.1,
          "range": [
            0.0,
            2.0
          ],
          "targets": [
            "1:release"
          ]
        },
        {
          "name": "knee",
          "type": "float",
          "unit": "db",
          "default": 6.0,
          "range": [
            0.0,
            24.0
          ],
          "targets": [
            "2:knee"
          ]
        },
        {
          "name": "makeup",
          "type": "float",
          "unit": "db",
          "default": 0.0,
          "range": [
            0.0,
            24.0
          ],
          "targets": [
            "3:b"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "4:out"
        },
        {
          "name": "gain_reduction",
          "type": "float",
          "source": "2:gain_reduction"
        }
      ],
      "graph": {
        "nodes": [
          {
            "id": "1",
            "kind": "envelope_follower",
            "params": {
              "mode": "peak"
            },
            "ui": {
              "pos": [
                0.0,
                0.0
              ],
              "label": "Detector"
            }
          },
          {
            "id": "2",
            "kind": "gain_computer",
            "params": {
              "mode": "compress"
            },
            "ui": {
              "pos": [
                220.0,
                0.0
              ]
            }
          },
          {
            "id": "3",
            "kind": "math",
            "params": {
              "op": "add"
            },
            "ui": {
              "pos": [
                440.0,
                0.0
              ],
              "label": "Make-up"
            }
          },
          {
            "id": "4",
            "kind": "gain",
            "ui": {
              "pos": [
                660.0,
                0.0
              ]
            }
          }
        ],
        "wires": [
          {
            "from": "1:level_db",
            "to": "2:level"
          },
          {
            "from": "2:gain_reduction",
            "to": "3:a"
          },
          {
            "from": "3:out",
            "to": "4:gain"
          }
        ]
      }
    },
    "hall-reverb": {
      "name": "Hall Reverb",
      "description": "A large, dark hall: a soft wash of early echoes that blooms into a long, smooth tail whose highs fade first, as in a big room. Mono or stereo in, stereo out.\n\n- `in`: the signal.\n- `predelay` (s): the gap before the reverb, as if the walls were further away; 0.02 to 0.08 s for a hall.\n- `decay` (s): how long the tail takes to fall by 60 dB (its RT60) in the low and middle frequencies.\n- `damping` (0 to 1): how much faster the highs die away; 0 is a bright, hard room, 0.2 a concert hall (highs last about half as long as lows), 0.5 a dark, heavy space. Above about 0.6 the lows shorten too.\n- `mix` (0 to 1): 0 is dry, 1 only the reverb. The blend is equal-power, so the loudness holds steady; around 0.25 places a sound in the hall, 1 is for a reverb on a send.\n- `out`: the stereo result.\n\nInside: the classic parallel-comb, series-allpass reverberator of M. R. Schroeder (\"Natural sounding artificial reverberation\", JAES, 1962), with J. A. Moorer's lowpass filters in the comb loops and his six comb delays from 50 to 78 ms (\"About this reverberation business\", Computer Music Journal, 1979). A Delay sets `predelay`, and a Diffuser smears the input into a decorrelated stereo pair (its left and right chains have different delays), which gives the early echoes and the width. Six feedback Combs in parallel, each fed both channels, make the tail, with `damping` as their loop lowpass. For every comb to fall 60 dB in `decay` seconds, a comb of delay d needs a feedback of 10^(−3·d ÷ `decay`): Math and Convert work out 10^(−3 ÷ `decay`), the gain per second, and a Math power per comb raises it to that comb's delay. A Mix sums the combs with the Diffuser's own output, which fills the first 50 ms before the combs answer, two Allpasses (6 and 1.7 ms) thicken the echoes, and an equal-power Crossfade blends the result with the dry input.",
      "version": 1,
      "author": "Audio Constructor",
      "tags": [
        "reverb",
        "space",
        "hall",
        "stereo",
        "effect"
      ],
      "source": "shipped:hall-reverb",
      "inputs": [
        {
          "name": "in",
          "type": "audio",
          "targets": [
            "1:in",
            "33:a"
          ]
        },
        {
          "name": "predelay",
          "type": "float",
          "unit": "seconds",
          "default": 0.03,
          "range": [
            0.0,
            0.25
          ],
          "targets": [
            "1:time"
          ]
        },
        {
          "name": "decay",
          "type": "float",
          "unit": "seconds",
          "default": 3.5,
          "range": [
            0.5,
            20.0
          ],
          "targets": [
            "3:b"
          ]
        },
        {
          "name": "damping",
          "type": "float",
          "default": 0.2,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "20:damping",
            "21:damping",
            "22:damping",
            "23:damping",
            "24:damping",
            "25:damping"
          ]
        },
        {
          "name": "mix",
          "type": "float",
          "default": 0.3,
          "range": [
            0.0,
            1.0
          ],
          "targets": [
            "33:mix"
          ]
        }
      ],
      "outputs": [
        {
          "name": "out",
          "type": "audio",
          "source": "33:out"
        }
      ],
      "graph": {
        "nodes": [
          {
