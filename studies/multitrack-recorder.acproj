{
  "schema_version": 2,
  "name": "Multitrack Recorder",
  "settings": {
    "sample_rate": 48000,
    "length": 32.0,
    "seed": 0,
    "block_size": 256,
    "tempo": [
      {
        "beat": 0.0,
