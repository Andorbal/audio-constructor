      16.0,
      24.0
    ],
    "markers": [
      {
        "beat": 0.0,
        "name": "Intro"
      },
      {
        "beat": 16.0,
        "name": "Chords"
      },
      {
        "beat": 32.0,
        "name": "Lead"
      },
