{
  "schema_version": 1,
  "name": "Compressor",
  "description": "Evens out levels: whenever the signal rises above `threshold`, it is turned down so that every `ratio` dB over the threshold comes out as 1 dB over. Mono or stereo (both sides are turned down together, so the image stays put).\n\n- `threshold` (dB): the level where compression starts.\n- `ratio`: how hard levels over the threshold are pressed down; 4 means 4:1, 20 and up is close to limiting.\n- `attack` and `release` (seconds): how quickly the compressor turns down when the level jumps up, and how quickly it lets go when it falls back.\n- `knee` (dB): rounds the corner at the threshold over that width so compression sets in gradually; 0 is a hard knee.\n- `makeup` (dB): gain added after compression to win back the lost level.\n- `gain_reduction` (output, dB): how far the signal is being turned down right now (0 or negative, before `makeup`), for a meter or to drive something else.\n\nInside: an Envelope Follower measures the peak level in decibels with the attack and release times, a Gain Computer turns that level into a gain change from the threshold, ratio, and knee, a Math node adds the make-up gain, and a Gain applies the result to the input.",
  "version": 1,
  "author": "Audio Constructor",
  "tags": [
    "dynamics",
    "compressor",
    "mixing"
  ],
  "inputs": [
    {
      "name": "in",
      "type": "audio",
      "targets": [
        "1:in",
        "4:in"
      ]
    },
    {
      "name": "threshold",
      "type": "float",
      "unit": "db",
      "default": -20.0,
      "range": [
        -60.0,
        0.0
      ],
      "targets": [
        "2:threshold"
      ]
    },
    {
      "name": "ratio",
      "type": "float",
      "unit": "ratio",
      "default": 4.0,
      "range": [
        1.0,
        20.0
      ],
      "targets": [
        "2:ratio"
      ]
    },
    {
      "name": "attack",
      "type": "float",
      "unit": "seconds",
      "default": 0.01,
      "range": [
        0.0,
        0.5
      ],
      "targets": [
        "1:attack"
      ]
    },
    {
      "name": "release",
      "type": "float",
      "unit": "seconds",
      "default": 0.1,
      "range": [
        0.0,
        2.0
      ],
      "targets": [
        "1:release"
      ]
    },
    {
      "name": "knee",
      "type": "float",
      "unit": "db",
      "default": 6.0,
      "range": [
        0.0,
        24.0
      ],
      "targets": [
        "2:knee"
      ]
    },
    {
      "name": "makeup",
      "type": "float",
      "unit": "db",
      "default": 0.0,
      "range": [
        0.0,
        24.0
      ],
      "targets": [
        "3:b"
      ]
    }
  ],
  "outputs": [
    {
      "name": "out",
      "type": "audio",
      "source": "4:out"
    },
    {
      "name": "gain_reduction",
      "type": "float",
      "source": "2:gain_reduction"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "1",
        "kind": "envelope_follower",
        "params": {
          "mode": "peak"
        },
        "ui": {
          "pos": [
            0.0,
            0.0
          ],
          "label": "Detector"
        }
      },
      {
        "id": "2",
        "kind": "gain_computer",
        "params": {
          "mode": "compress"
        },
        "ui": {
          "pos": [
            220.0,
            0.0
          ]
        }
      },
      {
        "id": "3",
        "kind": "math",
        "params": {
          "op": "add"
        },
        "ui": {
          "pos": [
            440.0,
            0.0
          ],
          "label": "Make-up"
        }
      },
      {
        "id": "4",
        "kind": "gain",
        "ui": {
          "pos": [
            660.0,
            0.0
          ]
        }
      }
    ],
    "wires": [
      {
        "from": "1:level_db",
        "to": "2:level"
      },
      {
        "from": "2:gain_reduction",
        "to": "3:a"
      },
      {
        "from": "3:out",
        "to": "4:gain"
      }
    ]
  }
}
