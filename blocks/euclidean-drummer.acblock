{
  "schema_version": 1,
  "name": "Euclidean Drummer",
  "description": "Three drums playing Euclidean rhythms from one clock: a kick, a snare, and a hi-hat, each spreading its hits as evenly as possible over its own cycle of steps. Give the drums cycles of different lengths and they drift against each other into long, shifting grooves. It plays while the transport runs, in time with the project's tempo.\n\n- `step` is the length of one step in beats (0.25 is sixteenth notes).\n- For each drum (`kick_`, `snare_`, `hat_`): `steps` is the length of its cycle, `pulses` how many hits are spread over it, and `rotation` how many steps later the pattern starts. 4 pulses in 16 steps is four on the floor, 3 in 8 the tresillo, and 5 or 7 in 16 classic syncopated grooves; try a hat cycle of 12 against a kick cycle of 16.\n- `kick_level`, `snare_level`, and `hat_level` set each drum's loudness in decibels (−60 is silent).\n- `out` is the mix, mono. `kick`, `snare`, and `hat` fire a trigger on every hit, to play other sounds too (Samplers, a synth's envelope).\n\nInside: one Clock drives three Euclidean nodes, and each one's trigger starts a synthesized drum. The kick is a sine Oscillator restarted on every hit, its pitch dropping fast from 200 to 45 Hz (an ADSR through an exponential Map) under a longer ADSR for the volume. The snare is white Noise through a highpass Biquad plus a short 185 Hz triangle for the body, balanced by a small Mix. The hi-hat is the same Noise through a 7 kHz highpass with a short envelope. A Mix sets the levels.",
  "version": 1,
  "author": "Audio Constructor",
  "tags": [
    "drums",
    "rhythm",
    "euclidean",
    "generative",
    "instrument"
  ],
  "inputs": [
    {
      "name": "step",
      "type": "float",
      "unit": "beats",
      "default": 0.25,
      "range": [
        0.0625,
        1.0
      ],
      "targets": [
        "1:interval"
      ]
    },
    {
      "name": "kick_steps",
      "type": "int",
      "default": 16,
      "range": [
        1.0,
        32.0
      ],
      "targets": [
        "2:steps"
      ]
    },
    {
      "name": "kick_pulses",
      "type": "int",
      "default": 5,
      "range": [
        0.0,
        32.0
      ],
      "targets": [
        "2:pulses"
      ]
    },
    {
      "name": "kick_rotation",
      "type": "int",
      "default": 0,
      "range": [
        0.0,
        31.0
      ],
      "targets": [
        "2:rotation"
      ]
    },
    {
      "name": "snare_steps",
      "type": "int",
      "default": 16,
      "range": [
        1.0,
        32.0
      ],
      "targets": [
        "3:steps"
      ]
    },
    {
      "name": "snare_pulses",
      "type": "int",
      "default": 2,
      "range": [
        0.0,
        32.0
      ],
      "targets": [
        "3:pulses"
      ]
    },
    {
      "name": "snare_rotation",
      "type": "int",
      "default": 4,
      "range": [
        0.0,
        31.0
      ],
      "targets": [
        "3:rotation"
      ]
    },
    {
      "name": "hat_steps",
      "type": "int",
      "default": 16,
      "range": [
        1.0,
        32.0
      ],
      "targets": [
        "4:steps"
      ]
    },
    {
      "name": "hat_pulses",
      "type": "int",
      "default": 7,
      "range": [
        0.0,
        32.0
      ],
      "targets": [
        "4:pulses"
      ]
    },
    {
      "name": "hat_rotation",
      "type": "int",
      "default": 0,
      "range": [
        0.0,
        31.0
      ],
      "targets": [
        "4:rotation"
      ]
    },
    {
      "name": "kick_level",
      "type": "float",
      "unit": "db",
      "default": -6.0,
      "range": [
        -60.0,
        12.0
      ],
      "targets": [
        "15:gain_0"
      ]
    },
    {
      "name": "snare_level",
      "type": "float",
      "unit": "db",
      "default": -9.0,
      "range": [
        -60.0,
        12.0
      ],
      "targets": [
        "15:gain_1"
      ]
    },
    {
      "name": "hat_level",
      "type": "float",
      "unit": "db",
      "default": -12.0,
      "range": [
        -60.0,
        12.0
      ],
      "targets": [
        "15:gain_2"
      ]
    }
  ],
  "outputs": [
    {
      "name": "out",
      "type": "audio",
      "source": "15:out"
    },
    {
      "name": "kick",
      "type": "trigger",
      "source": "2:trigger"
    },
    {
      "name": "snare",
      "type": "trigger",
      "source": "3:trigger"
    },
    {
      "name": "hat",
      "type": "trigger",
      "source": "4:trigger"
    }
  ],
